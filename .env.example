# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and never committed.

# --- Email delivery for the contact/intake form (required for submissions) ---
# Uses the Resend HTTPS API. Without all three values, the form fails closed
# and tells the visitor to email the practice directly.
RESEND_API_KEY=
# Where intake submissions should be emailed:
INTAKE_TO_EMAIL=
# The "from" address (must be a domain you've verified in Resend):
INTAKE_FROM_EMAIL=

# Email is not a substitute for a secure clinical/EHR intake system. Confirm
# your privacy/compliance requirements before collecting protected health
# information through any email provider.
